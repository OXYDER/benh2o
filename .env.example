# Copie ce fichier en ".env" (même dossier) et remplis de vraies valeurs.
# Ce fichier .env ne doit JAMAIS être commité — il est déjà dans .gitignore.

# Mot de passe de la base de données Postgres (choisis une valeur longue et aléatoire)
DB_PASSWORD=change-moi-pour-un-mot-de-passe-long-et-aleatoire

# Clé secrète utilisée pour signer les sessions d'administration (longue chaîne aléatoire)
# Génère-en une avec : openssl rand -base64 48
JWT_SECRET=change-moi-aussi-pour-une-cle-longue-et-aleatoire
