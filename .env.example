# Copie ce fichier en ".env" (même dossier) et remplis de vraies valeurs.
# Ce fichier .env ne doit JAMAIS être commité — il est déjà dans .gitignore.

# Mot de passe de la base de données Postgres (choisis une valeur longue et aléatoire)
DB_PASSWORD=change-moi-pour-un-mot-de-passe-long-et-aleatoire

# Clé secrète utilisée pour signer les sessions d'administration (longue chaîne aléatoire)
# Génère-en une avec : openssl rand -base64 48
JWT_SECRET=change-moi-aussi-pour-une-cle-longue-et-aleatoire

# ---------- Chatwoot (clavardage en direct) ----------

# Mot de passe de la base de données dédiée à Chatwoot (différent de DB_PASSWORD ci-dessus)
# ⚠️ Génère-le avec : openssl rand -hex 24 (surtout pas -base64 : les caractères
# comme / + = cassent l'URL redis://... que Chatwoot construit avec ce mot de passe)
CHATWOOT_DB_PASSWORD=change-moi-pour-un-autre-mot-de-passe-long-et-aleatoire

# Mot de passe du Redis dédié à Chatwoot
# ⚠️ Génère-le avec : openssl rand -hex 24 (jamais -base64, même raison que ci-dessus —
# ce mot de passe est inséré directement dans une URL redis://:motdepasse@host:port)
CHATWOOT_REDIS_PASSWORD=change-moi-pour-un-mot-de-passe-redis-long-et-aleatoire

# Clé de signature interne de Chatwoot (Rails) — génère avec : openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=change-moi-pour-une-cle-hex-de-64-caracteres

# L'adresse publique où Chatwoot sera accessible (sous-domaine dédié, ex. chat.benoitlaprise.com)
CHATWOOT_FRONTEND_URL=https://chat.benoitlaprise.com
